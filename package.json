{
  "name": "ai-infra-filings-mcp",
  "version": "0.1.0",
  "description": "MCP server that answers questions about AI-infrastructure spending at public tech companies, using real SEC EDGAR filings",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "load": "tsx src/load-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval": "npm run build && tsx evals/run.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
