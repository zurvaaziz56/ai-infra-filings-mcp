# Required for every SEC request. The SEC rejects requests without a contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# The role this server runs as: viewer, analyst, data_engineer or admin (see config/roles.json).
MCP_ROLE=viewer

# Optional. Lets data engineers file data issues on GitHub. Use a fine-grained token limited to
# one repository, with "Issues: Read and write" only. Without these, file_data_issue shows drafts.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Leave DATABASE_URL unset to use the embedded PGlite database in ./data.
# With docker compose up, load as the owner and serve as the read-only reader:
# DATABASE_URL=postgres://filings_owner:filings_owner_dev@localhost:55433/filings
# DATABASE_URL=postgres://filings_reader:filings_reader_dev@localhost:55433/filings
