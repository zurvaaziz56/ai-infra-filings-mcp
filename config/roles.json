{
  "roles": {
    "viewer": {
      "description": "Reads normalized metrics. No live full-text search.",
      "tools": ["get_company", "get_metric", "compare_metric", "source_status"],
      "sec_requests_per_minute": 10
    },
    "analyst": {
      "description": "Everything a viewer has, plus live full-text search of filings.",
